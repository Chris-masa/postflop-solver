package holdem-solver:range

interface GuestRangeManager {
  /// Range を構築して初期化します。
  resource range

  /// 新しい空のレンジを作成します。
  new: func() -> range

  /// レンジのすべての重みを 0 にクリアします。
  clear: func(self: range)

  /// レンジの特定のハンドの重みを更新します。
  update: func(self: range, row: u8, col: u8, weight: float32)

  /// 文字列からレンジを読み込みます。失敗時はエラー文字列を返します。
  from-string: func(self: range, input: string) -> option<string>

  /// レンジを文字列として出力します（例: "QQ+,AKs"）。
  to-string: func(self: range) -> string

  /// GUI 用 13x13 表現の重みデータを取得します。
  get-weights: func(self: range) -> list<float32>

  /// 内部の 169 長の生データを取得します。
  raw-data: func(self: range) -> list<float32>
}


world range {
  export  GuestRangeManager;
}